# Required. Supported values: deepseek, openai, openai-compatible.
LLM_PROVIDER=deepseek

# Required. Model name understood by the selected provider.
LLM_MODEL=deepseek-v4-flash

# Required when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=[use-your-own-api-keys]

# Required when LLM_PROVIDER=openai. For openai-compatible, set this when
# the endpoint requires authentication.
# OPENAI_API_KEY=

# Required only when LLM_PROVIDER=openai-compatible.
# OPENAI_BASE_URL=

# Optional. Authenticates GitHub API requests and increases rate limits.
GITHUB_TOKEN=[use-your-own-github-token]

# Optional. Configure these when outbound HTTP access requires a proxy.
# This is commonly needed for local web search from mainland China.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

# Optional. Set both keys to enable Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional. Custom Langfuse server URL; leave empty for the SDK default.
# LANGFUSE_BASE_URL=
