# ==================== [General] =========================

# Github proxy (ghfast) and personal token (increase rate limits)
GITHUB_MIRROR_ENABLED=true
GITHUB_TOKEN=[use-your-own-github-token]

# Optional. Configure these when outbound HTTP access requires a proxy.
# This is commonly needed for local web search from mainland China.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

# Optional. Set both keys to enable Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Claude CLI tracing uses VAMiner's bundled transcript hook; no user-scoped
# Claude plugin installation is required.

# Optional. Custom Langfuse server URL; leave empty for the SDK default.
# LANGFUSE_BASE_URL=

# Optional. Per-phase and per-anchor model turn ceilings.
MINER_MAX_TURNS_ISSUE_COLLECTION=50
MINER_MAX_TURNS_ROOT_CAUSE=50
MINER_MAX_TURNS_RULE_GENERATION=40
MINER_MAX_TURNS_PER_ANCHOR=40

# Optional. Default Agent Runtime: pydanic-sdk or claude-cli.
MINER_AGENT_RUNTIME=pydanic-sdk

# Optional. Override the workspace root, useful for isolated validation runs.
# VAMINER_WORKSPACE_DIR=/absolute/path/to/vas-workspaces

# Optional. Override the cache, log, and review root.
# VAMINER_OUTPUT_DIR=/absolute/path/to/vaminer-output


# ==================== [Runtime: Pydantic AI] =========================

# Required. Supported values: deepseek, openai, openai-compatible.
LLM_PROVIDER=deepseek

# Required. Model name understood by the selected provider.
LLM_MODEL=deepseek-v4-flash

# Required when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=[use-your-own-api-keys]

# Required when LLM_PROVIDER=openai. For openai-compatible, set this
# when the endpoint requires authentication.
# OPENAI_API_KEY=

# Required only when LLM_PROVIDER=openai-compatible.
# OPENAI_BASE_URL=

# ==================== [Runtime: Claude CLI] =========================

# Claude Code CLI Runtime. Use default user auth and only select the model here.
# CLAUDE_CODE_COMMAND=claude
# CLAUDE_CODE_MODEL=claude-sonnet-4-6
# CLAUDE_CODE_TIMEOUT_SECONDS=1800
