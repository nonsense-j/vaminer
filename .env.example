# Required. Supported values: deepseek, openai, openai-compatible.
LLM_PROVIDER=deepseek

# Required. Model name understood by the selected provider.
LLM_MODEL=deepseek-v4-flash

# Required when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=[use-your-own-api-keys]

# Required when LLM_PROVIDER=openai. For openai-compatible, set this when
# the endpoint requires authentication.
# OPENAI_API_KEY=

# Required only when LLM_PROVIDER=openai-compatible.
# OPENAI_BASE_URL=

# Optional. Authenticates GitHub API requests and increases rate limits.
GITHUB_TOKEN=[use-your-own-github-token]

# Optional. Configure these when outbound HTTP access requires a proxy.
# This is commonly needed for local web search from mainland China.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

# Optional. Set both keys to enable Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional. Custom Langfuse server URL; leave empty for the SDK default.
# LANGFUSE_BASE_URL=

# Optional. Default Agent Runtime: pydantic-ai or claude-code.
MINER_AGENT_RUNTIME=pydantic-ai

# Optional. Per-agent model request ceilings. Claude Code enforces these from
# stream-json message events; Pydantic AI maps them to UsageLimits.
# MINER_MAX_REQUESTS_PER_AGENT=100
# MINER_AST_GREP_MAX_REQUESTS_PER_ANCHOR=32

# Optional. Override artifact roots, useful for isolated validation runs.
# VAMINER_WORKSPACE_DIR=/absolute/path/to/vas-workspaces
# VAMINER_RULES_DIR=/absolute/path/to/generated-rules

# Claude Code CLI Runtime. Keep credentials in Claude settings or the process
# environment; never commit them here.
# CLAUDE_CODE_COMMAND=claude
# CLAUDE_CODE_MODEL=claude-sonnet-4-6
# CLAUDE_CODE_SETTINGS=/absolute/path/to/claude-runtime-settings.json
# CLAUDE_CODE_SETTING_SOURCES=user
# CLAUDE_CODE_TIMEOUT_SECONDS=1800
# CLAUDE_CODE_MAX_BUDGET_USD=5
